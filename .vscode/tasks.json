{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "./run.sh -B",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "CMake configure + build of src/main.cpp",
      "windows": {
        "command": "python run.py -B"
      }
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./run.sh",
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Build and run src/main.cpp (the graphics.h demo)",
      "windows": {
        "command": "python run.py"
      }
    },
    {
      "label": "Build current file",
      "type": "shell",
      "command": "./run.sh -B -f \"${relativeFile}\"",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compile the file open in the editor",
      "windows": {
        "command": "python run.py -B -f \"${relativeFile}\""
      }
    },
    {
      "label": "Run current file",
      "type": "shell",
      "command": "./run.sh -f \"${relativeFile}\"",
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compile and run the file open in the editor",
      "windows": {
        "command": "python run.py -f \"${relativeFile}\""
      }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build build-import-std",
      "detail": "Delete the build directory",
      "windows": {
        "command": "cmd /c rmdir /s /q build 2>nul & rmdir /s /q build-import-std 2>nul"
      }
    }
  ]
}
